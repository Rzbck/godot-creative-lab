* text=auto

# Godot / source / docs
*.godot      text eol=lf
*.gd         text eol=lf
*.gdshader   text eol=lf
*.tscn       text eol=lf
*.tres       text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Windows scripts
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binary assets
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.mp4        binary
*.mov        binary
